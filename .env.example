# Copy these into Netlify: Site configuration > Environment variables.
# Never commit real values.

# Supabase project (Sydney region). Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (resend.com). Verify your domain first so emails don't land in spam.
RESEND_API_KEY=re_xxxxxxxx
LEAD_EMAIL_FROM=Elevate Applications <applications@elevateassetfinance.com.au>
LEAD_EMAIL_TO=you@example.com

# Optional: lock the function to your own domains (comma separated)
ALLOWED_ORIGINS=https://elevateassetfinance.com.au,https://www.elevateassetfinance.com.au
